    <!-- Security Analysis Report (used in SecurityUtils) -->
    <string name="sec_report_high_intro">✅ This key is highly secure.\n\n</string>
    <string name="sec_report_med_intro">⚠️ Good key, but might be blocked by strict DPI.\n\n</string>
    <string name="sec_report_low_intro">⛔ Key uses outdated encryption or obfuscation.\n\n</string>

    <string name="sec_proto_vless">• Protocol: VLESS (Modern, fast).\n</string>
    <string name="sec_flow_vision">• Flow: XTLS-Vision (Excellent detection protection).\n</string>
    <string name="sec_security_reality">• Security: REALITY (Highest camouflage as Google/Microsoft).\n</string>
    <string name="sec_security_tls">• Security: TLS (Good encryption, like HTTPS).\n</string>
    <string name="sec_security_none">⚠ Security: None/Plain (Traffic is unencrypted or easily detected).\n</string>
    <string name="sec_proto_vmess">• Protocol: VMess (Standard, vulnerable to probing).\n</string>
    <string name="sec_obfu_tls">• Obfuscation: TLS/WebSocket (Decent stealth).\n</string>
    <string name="sec_proto_ss2022">• Protocol: Shadowsocks 2022 (Improved, replay protection).\n</string>
    <string name="sec_proto_ss">• Protocol: Shadowsocks (Classic. May be blocked by DPI).\n</string>
    <string name="sec_proto_wg">• Protocol: WireGuard (Max speed &amp; crypto. UDP may be blocked).\n</string>
    <string name="sec_proto_outline">• Protocol: Outline (Resistant to blocks, but not perfect).\n</string>
    <string name="sec_proto_openvpn">• Protocol: OpenVPN (Reliable but slow).\n</string>
