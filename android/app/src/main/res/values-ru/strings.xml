    <!-- Security Analysis Report -->
    <string name="sec_report_high_intro">✅ Этот ключ очень надежен.\n\n</string>
    <string name="sec_report_med_intro">⚠️ Хороший ключ, но может блокироваться строгими DPI.\n\n</string>
    <string name="sec_report_low_intro">⛔ Ключ использует устаревшие методы шифрования или маскировки.\n\n</string>

    <string name="sec_proto_vless">• Протокол: VLESS (Современный, быстрый).\n</string>
    <string name="sec_flow_vision">• Flow: XTLS-Vision (Отличная защита от обнаружения).\n</string>
    <string name="sec_security_reality">• Security: REALITY (Наивысшая степень маскировки под Google/Microsoft).\n</string>
    <string name="sec_security_tls">• Security: TLS (Хорошее шифрование, как у HTTPS).\n</string>
    <string name="sec_security_none">⚠ Security: None/Plain (Трафик не зашифрован или легко детектируется).\n</string>
    <string name="sec_proto_vmess">• Протокол: VMess (Стандартный, но уязвим к активному зондированию).\n</string>
    <string name="sec_obfu_tls">• Обфускация: TLS/WebSocket (Нормальная скрытность).\n</string>
    <string name="sec_proto_ss2022">• Протокол: Shadowsocks 2022 (Улучшенный, защищен от replay атак).\n</string>
    <string name="sec_proto_ss">• Протокол: Shadowsocks (Классический. Может блокироваться DPI).\n</string>
    <string name="sec_proto_wg">• Протокол: WireGuard (Максимальная скорость и криптография. Но может блокироваться по протоколу UDP).\n</string>
    <string name="sec_proto_outline">• Протокол: Outline (Устойчив к блокировкам, но не идеален).\n</string>
    <string name="sec_proto_openvpn">• Протокол: OpenVPN (Надежный, но медленный).\n</string>
    <string name="sec_proto_other">• Протокол: %1$s (Обычный).\n</string>

    <string name="sec_port_443">• Порт: 443 (Маскируется под HTTPS трафик).\n</string>
    <string name="sec_port_80">⚠ Порт: 80 (Обычный HTTP. Может быть подозрительно для VPN).\n</string>
    <string name="sec_port_other">• Порт: %1$d (Нестандартный порт).\n</string>
    
